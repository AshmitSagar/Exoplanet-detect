# AstroVet-ISRO Configuration Template
# Copy this file to .env and adjust values for your local environment

# Optional: STScI MAST API Token (increases rate limits for bulk TESS queries)
# Get your token at https://auth.mast.stsci.edu/
MAST_API_TOKEN=

# Directory Configuration (relative to repo root or absolute paths)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_AI_READY_DIR=data/ai_ready/npz
DATA_MODELS_DIR=data/models/training_run

# Training & Hardware Settings
DEFAULT_BATCH_SIZE=32
DEFAULT_NUM_WORKERS=4
USE_CUDA=true
CUBLAS_WORKSPACE_CONFIG=:4096:8
